---
interface Props {
  product: {
    id: string;
    data: {
      title: string;
      description: string;
      price: string;
      originalPrice?: string;
      discount?: string;
      affiliateUrl: string;
      affiliatePlatform: 'shopee' | 'amazon' | 'aliexpress' | 'shein' | 'magalu' | 'mercadolivre' | 'outros';
      category: string;
      badge?: string;
      badgeColor?: 'purple' | 'pink' | 'amber' | 'emerald';
      rating: number;
      reviewsCount: number;
      image: string;
      featured?: boolean;
      couponCode?: string;
      couponDiscount?: string;
      tags: string[];
    };
  };
}

const { product } = Astro.props;
const { data, id } = product;

// Platform metadata styling
const platformMeta = {
  shopee: { name: 'Shopee', bg: 'bg-orange-50 text-orange-700 border-orange-200', tag: 'Shopee' },
  amazon: { name: 'Amazon', bg: 'bg-amber-50 text-amber-900 border-amber-200', tag: 'Amazon' },
  shein: { name: 'Shein', bg: 'bg-pink-50 text-pink-700 border-pink-200', tag: 'Shein' },
  mercadolivre: { name: 'Mercado Livre', bg: 'bg-yellow-50 text-yellow-800 border-yellow-200', tag: 'Mercado Livre' },
  aliexpress: { name: 'AliExpress', bg: 'bg-red-50 text-red-700 border-red-200', tag: 'AliExpress' },
  magalu: { name: 'Magalu', bg: 'bg-blue-50 text-blue-700 border-blue-200', tag: 'Magalu' },
  outros: { name: 'Loja Confiável', bg: 'bg-purple-50 text-purple-700 border-purple-200', tag: 'Loja Parceira' },
}[data.affiliatePlatform] || { name: 'Loja Parceira', bg: 'bg-purple-50 text-purple-700 border-purple-200', tag: 'Loja Parceira' };

// Badge color
const badgeColors = {
  purple: 'bg-purple-600 text-white',
  pink: 'bg-pink-500 text-white',
  amber: 'bg-amber-500 text-white',
  emerald: 'bg-emerald-600 text-white',
}[data.badgeColor || 'purple'];

// Parse price for sorting: "R$ 139,90" -> 139.90
const numericPrice = parseFloat(data.price.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
const numericDiscount = data.discount ? parseInt(data.discount.replace(/[^\d]/g, '')) || 0 : 0;
---

<article
  class="product-card product-card-hover bg-white rounded-3xl border border-purple-100/90 shadow-sm overflow-hidden flex flex-col justify-between group transition-all duration-300"
  data-id={id}
  data-title={data.title.toLowerCase()}
  data-category={data.category.toLowerCase()}
  data-platform={data.affiliatePlatform.toLowerCase()}
  data-has-coupon={data.couponCode ? "true" : "false"}
  data-featured={data.featured ? "true" : "false"}
  data-price={numericPrice}
  data-discount={numericDiscount}
  data-rating={data.rating}
  data-tags={data.tags.join(',').toLowerCase()}
>
  <!-- Top image & badges container -->
  <div class="relative w-full aspect-square overflow-hidden bg-purple-50/50">
    <a href={`/produto/${id}`} class="block w-full h-full">
      <img
        src={data.image}
        alt={data.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </a>

    <!-- Top Floating Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none gap-2">
      <!-- Highlight badge -->
      {data.badge && (
        <span class={`px-2.5 py-1 rounded-full text-[11px] font-black tracking-wide shadow-md ${badgeColors}`}>
          ★ {data.badge}
        </span>
      )}

      <!-- Store Pill -->
      <span class={`ml-auto px-2.5 py-0.8 rounded-full text-[11px] font-bold border shadow-sm ${platformMeta.bg}`}>
        {platformMeta.name}
      </span>
    </div>

    <!-- Quick view link overlay on hover -->
    <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-purple-950/60 via-purple-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
      <a
        href={`/produto/${id}`}
        class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/95 text-purple-900 shadow-md hover:bg-white hover:text-purple-700 transition-colors"
      >
        Ver resenha completa &rarr;
      </a>
    </div>
  </div>

  <!-- Product Details Body -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
    
    <div>
      <!-- Category & Rating -->
      <div class="flex items-center justify-between text-xs text-slate-500 mb-2 gap-2">
        <span class="text-purple-600 font-semibold bg-purple-50 px-2 py-0.5 rounded-md">
          {data.category}
        </span>

        <div class="flex items-center gap-1 text-amber-500 font-bold">
          <span>★</span>
          <span>{data.rating.toFixed(1)}</span>
          <span class="text-slate-400 font-normal">({data.reviewsCount > 1000 ? `${(data.reviewsCount/1000).toFixed(1)}k` : data.reviewsCount})</span>
        </div>
      </div>

      <!-- Title -->
      <h3 class="font-bold text-slate-900 text-base leading-snug line-clamp-2 group-hover:text-purple-700 transition-colors">
        <a href={`/produto/${id}`}>
          {data.title}
        </a>
      </h3>

      <!-- Short Description -->
      <p class="text-xs text-slate-500 line-clamp-2 mt-1.5 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Pricing Area -->
    <div class="pt-2 border-t border-purple-50">
      <div class="flex items-baseline gap-2">
        <span class="text-2xl font-black font-display text-purple-800 tracking-tight">
          {data.price}
        </span>
        {data.originalPrice && (
          <span class="text-xs text-slate-400 line-through">
            {data.originalPrice}
          </span>
        )}
        {data.discount && (
          <span class="ml-auto text-xs font-black text-pink-600 bg-pink-50 border border-pink-200 px-2 py-0.5 rounded-md">
            {data.discount}
          </span>
        )}
      </div>

      <!-- Coupon box (if available) -->
      {data.couponCode && (
        <div class="mt-2.5 bg-purple-50/80 border border-purple-200/80 rounded-xl p-2 flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 overflow-hidden">
            <span class="text-purple-600 text-xs">🏷️</span>
            <span class="text-[11px] font-bold text-purple-900 truncate">
              {data.couponDiscount ? `${data.couponDiscount}:` : 'Cupom:'}
            </span>
            <span class="font-mono text-xs font-black text-purple-700 bg-white px-1.5 py-0.5 rounded border border-purple-200">
              {data.couponCode}
            </span>
          </div>

          <button
            type="button"
            onclick={`window.copyCoupon('${data.couponCode}', this)`}
            class="shrink-0 px-2 py-1 text-[11px] font-bold text-purple-700 hover:text-white hover:bg-purple-600 border border-purple-300 rounded-lg transition-colors cursor-pointer"
          >
            Copiar
          </button>
        </div>
      )}
    </div>

    <!-- Direct Affiliate CTA Button -->
    <div class="space-y-2 pt-1">
      <a
        href={data.affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-2xl text-sm font-bold bg-gradient-to-r from-purple-700 via-purple-600 to-purple-800 text-white shadow-md shadow-purple-600/20 hover:shadow-purple-600/35 hover:scale-[1.01] active:scale-[0.99] transition-all"
      >
        <span>Ver na {platformMeta.name}</span>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>

      <a
        href={`/produto/${id}`}
        class="w-full text-center block text-xs font-semibold text-purple-700 hover:text-purple-900 py-1 transition-colors"
      >
        Ler minha resenha & detalhes &rarr;
      </a>
    </div>

  </div>
</article>
