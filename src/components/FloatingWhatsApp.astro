---
// Floating WhatsApp / VIP Alerts Group Button
---

<aside class="fixed bottom-6 right-5 z-40 flex flex-col items-end group" aria-label="Acesso rápido ao canal VIP">
  <!-- Tooltip speech bubble -->
  <div class="mb-2 hidden sm:flex items-center gap-2 bg-white text-purple-900 px-3.5 py-1.5 rounded-2xl shadow-lg border border-purple-100 text-xs font-semibold animate-pulse-subtle">
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
    <span>Grupo VIP de Ofertas e Cupons 💜</span>
  </div>

  <a
    href="https://chat.whatsapp.com"
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center justify-center w-14 h-14 bg-gradient-to-tr from-emerald-500 to-emerald-600 text-white rounded-full shadow-xl hover:shadow-emerald-500/40 hover:scale-105 active:scale-95 transition-all duration-300"
    title="Entrar no Grupo VIP de Achadinhos no WhatsApp"
  >
    <!-- Ripple effect ring -->
    <span class="absolute -inset-1 rounded-full bg-emerald-400 opacity-30 group-hover:animate-ping -z-10"></span>
    
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.974.53 1.776.816 2.796.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.768-5.767-5.768zm0 10.377c-.901 0-1.637-.253-2.428-.718l-.174-.103-1.785.468.477-1.74-.114-.181c-.506-.807-.775-1.579-.775-2.504 0-2.541 2.067-4.609 4.609-4.609 2.541 0 4.609 2.068 4.609 4.609 0 2.541-2.068 4.609-4.609 4.609zm3.504-3.447c-.192-.096-1.137-.561-1.314-.625-.176-.064-.304-.096-.432.096-.128.192-.496.625-.608.753-.112.128-.224.144-.416.048-.192-.096-.812-.299-1.547-.954-.572-.51-9.58-1.141-.1.288-.048-.096-.064-.176.032-.304.096-.128.224-.32.336-.48.112-.16.144-.272.224-.448.08-.176.048-.336-.016-.48-.064-.144-.432-1.04-.592-1.424-.156-.374-.315-.323-.432-.329-.112-.006-.24-.007-.368-.007-.128 0-.336.048-.512.24-.176.192-.672.656-.672 1.6 0 .944.688 1.856.784 1.984.096.128 1.354 2.067 3.28 2.898.458.198.816.316 1.095.405.46.146.879.125 1.21.076.369-.055 1.137-.465 1.297-.914.16-.449.16-.834.112-.914-.048-.08-.176-.128-.368-.224z" />
    </svg>
  </a>
</aside>
