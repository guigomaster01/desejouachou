---
const currentYear = new Date().getFullYear();
---

<footer class="bg-purple-950 text-purple-100 pt-16 pb-12 border-t border-purple-900/60 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-purple-900/80">
      
      <!-- Brand Info (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-white shadow-md">
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <span class="text-2xl font-black font-display tracking-tight text-white">
            Desejou<span class="text-purple-400">Achou</span>
            <span class="text-pink-400 text-sm">✦</span>
          </span>
        </a>

        <p class="text-sm text-purple-200/80 max-w-sm leading-relaxed">
          Sua curadoria feminina favorita de achadinhos, promoções imperdíveis e cupons secretos da internet. Tudo testado, aprovado e com links 100% seguros! 💜
        </p>

        <!-- Social Media Icons -->
        <div class="flex items-center gap-3 pt-2">
          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-purple-900/60 hover:bg-purple-800 text-purple-200 hover:text-white flex items-center justify-center transition-colors border border-purple-800/80"
            title="Instagram"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-purple-900/60 hover:bg-purple-800 text-purple-200 hover:text-white flex items-center justify-center transition-colors border border-purple-800/80"
            title="TikTok"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 00-1-.08A6.34 6.34 0 003 15.66a6.34 6.34 0 0010.86 4.43v-7a8.16 8.16 0 004.73 1.52v-3.4a4.85 4.85 0 01-2-.52z"/>
            </svg>
          </a>

          <!-- Pinterest -->
          <a
            href="https://pinterest.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-purple-900/60 hover:bg-purple-800 text-purple-200 hover:text-white flex items-center justify-center transition-colors border border-purple-800/80"
            title="Pinterest"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0a12 12 0 00-4.37 23.17c-.07-.94-.13-2.39.03-3.42l1-4.28s-.26-.51-.26-1.27c0-1.19.69-2.08 1.55-2.08.73 0 1.08.55 1.08 1.21 0 .74-.47 1.84-.71 2.86-.2.86.43 1.56 1.28 1.56 1.54 0 2.72-1.62 2.72-3.96 0-2.07-1.49-3.52-3.61-3.52-2.46 0-3.91 1.84-3.91 3.75 0 .74.29 1.54.64 1.97.07.09.08.17.06.26l-.24.97c-.04.16-.13.19-.3.12-1.12-.52-1.82-2.15-1.82-3.46 0-2.82 2.05-5.41 5.91-5.41 3.1 0 5.51 2.21 5.51 5.16 0 3.08-1.94 5.56-4.64 5.56-.91 0-1.76-.47-2.05-1.03l-.56 2.13c-.2.78-.75 1.76-1.12 2.36A12 12 0 1012 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navegação -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Navegação</h4>
        <ul class="space-y-2 text-sm text-purple-200/80">
          <li><a href="/" class="hover:text-purple-300 transition-colors">Início</a></li>
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Todos os Achadinhos</a></li>
          <li><a href="/cupons" class="hover:text-purple-300 transition-colors">Central de Cupons</a></li>
          <li><a href="/sobre" class="hover:text-purple-300 transition-colors">Sobre a Criadora</a></li>
          <li><a href="/gerador" class="hover:text-purple-300 transition-colors text-purple-300 font-semibold">✨ Painel Gerador (.md)</a></li>
        </ul>
      </div>

      <!-- Column 3: Categorias -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Categorias</h4>
        <ul class="space-y-2 text-sm text-purple-200/80">
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Beleza & Cabelo</a></li>
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Casa & Cozinha</a></li>
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Moda & Acessórios</a></li>
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Achados Tech</a></li>
          <li><a href="/#produtos" class="hover:text-purple-300 transition-colors">Organização & Papelaria</a></li>
        </ul>
      </div>

      <!-- Column 4: Lojas Parceiras -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Lojas Parceiras</h4>
        <ul class="space-y-2 text-sm text-purple-200/80">
          <li><a href="https://shopee.com.br" target="_blank" rel="noopener nofollow" class="hover:text-purple-300 transition-colors">Shopee Oficial</a></li>
          <li><a href="https://amazon.com.br" target="_blank" rel="noopener nofollow" class="hover:text-purple-300 transition-colors">Amazon Brasil</a></li>
          <li><a href="https://shein.com.br" target="_blank" rel="noopener nofollow" class="hover:text-purple-300 transition-colors">Shein</a></li>
          <li><a href="https://mercadolivre.com.br" target="_blank" rel="noopener nofollow" class="hover:text-purple-300 transition-colors">Mercado Livre</a></li>
        </ul>
      </div>

    </div>

    <!-- Affiliate Legal Disclaimer (Crucial for compliance) -->
    <div class="mt-8 pt-6 text-xs text-purple-300/70 space-y-2 leading-relaxed">
      <p>
        <strong>Aviso de Transparência e Afiliados:</strong> O site <em>Desejou Achou</em> participa de programas de afiliados da Amazon, Shopee, Shein, Mercado Livre e outras plataformas confiáveis. Isso significa que podemos receber uma pequena comissão por compras qualificadas realizadas através dos links disponibilizados aqui. Você nunca paga nada a mais por isso e os cupons compartilhados ajudam você a economizar! Os preços e a disponibilidade dos produtos podem sofrer alterações após a data de publicação.
      </p>
    </div>

    <!-- Copyright Bar -->
    <div class="mt-8 pt-6 border-t border-purple-900/60 flex flex-col sm:flex-row items-center justify-between text-xs text-purple-300/60 gap-4">
      <p>
        &copy; {currentYear} Desejou Achou. Feito com amor e carinho 💜
      </p>
      <div class="flex items-center gap-4">
        <a href="/sobre" class="hover:underline">Privacidade & Termos</a>
        <span>•</span>
        <a href="https://chat.whatsapp.com/JfqhZBxAiS9AVHGI2LIvGq" target="_blank" rel="noopener noreferrer" class="hover:underline text-emerald-400 font-bold">Grupo VIP</a>
      </div>
    </div>

  </div>
</footer>
